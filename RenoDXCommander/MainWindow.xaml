                                            Background="{StaticResource SurfaceOverlayBrush}"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32"
                                            Click="DofFixInfoButton_Click"/>
                                    <Button x:Name="DetailDofFixInstallBtn" x:FieldModifier="internal" Grid.Column="3"
                                            Click="InstallDofFixButton_Click"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            CornerRadius="8" FontSize="12" Height="32"/>
                                    <Button x:Name="DetailDofFixCogBtn" x:FieldModifier="internal" Grid.Column="4"
                                            Visibility="Collapsed"
                                            Click="DofFixCogButton_Click"
                                            Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="DOF 수정 설정">
                                        <TextBlock Text="⚙" FontSize="14" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="DetailDofFixDeleteBtn" x:FieldModifier="internal" Grid.Column="5"
                                            Click="UninstallDofFixButton_Click"
                                            Background="{StaticResource AccentRedBgBrush}" Foreground="{StaticResource AccentRedBrush}"
                                            BorderBrush="{StaticResource AccentPurpleBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="DOF 수정 제거" Opacity="0" IsHitTestVisible="False">
                                        <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource AccentRedBrush}"/>
                                    </Button>
                                </Grid>

                                <!-- Labeled separator: choose one limiter -->
                                <Grid Margin="0,4,0,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="3" Text="———  프레임 제한기 — 하나만 선택  ———" FontSize="11"
                                               ToolTipService.ToolTip="ReLimiter와 Display Commander는 모두 프레임 속도를 제한합니다. 하나만 설치하세요."
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- ReLimiter row -->
                                <Grid x:Name="DetailUlRow" x:FieldModifier="internal" ColumnSpacing="8" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DetailUlLabel" x:FieldModifier="internal" Grid.Column="0" Text="ReLimiter" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DetailUlStatus" x:FieldModifier="internal" Grid.Column="1" FontSize="12"
                                               VerticalAlignment="Center" HorizontalTextAlignment="Center"
                                               PointerPressed="DetailUlStatus_PointerPressed"
                                               PointerEntered="LinkText_PointerEntered" PointerExited="LinkText_PointerExited"/>
                                    <Button x:Name="DetailUlInfoBtn" x:FieldModifier="internal" Grid.Column="2"
                                            Content="정보" FontSize="11" Padding="6,2,6,2"
                                            Background="{StaticResource SurfaceOverlayBrush}"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32"
                                            Click="InfoButton_Click"/>
                                    <Button x:Name="DetailUlInstallBtn" x:FieldModifier="internal" Grid.Column="3"
                                            Click="InstallUlButton_Click"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            CornerRadius="8" FontSize="12" Height="32"/>
                                    <Button x:Name="DetailUlIniBtn" x:FieldModifier="internal" Grid.Column="4"
                                            Click="UlCogButton_Click"
                                            Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="ReLimiter 설정">
                                        <TextBlock Text="⚙" FontSize="14" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="DetailUlDeleteBtn" x:FieldModifier="internal" Grid.Column="5"
                                            Click="UninstallUlButton_Click"
                                            Background="{StaticResource AccentRedBgBrush}" Foreground="{StaticResource AccentRedBrush}"
                                            BorderBrush="{StaticResource AccentPurpleBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="ReLimiter 제거" Opacity="0" IsHitTestVisible="False">
                                        <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource AccentRedBrush}"/>
                                    </Button>
                                </Grid>

                                <!-- Display Commander row -->
                                <Grid x:Name="DetailDcRow" x:FieldModifier="internal" ColumnSpacing="8" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DetailDcLabel" x:FieldModifier="internal" Grid.Column="0" Text="Display Commander" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DetailDcStatus" x:FieldModifier="internal" Grid.Column="1" FontSize="12"
                                               VerticalAlignment="Center" HorizontalTextAlignment="Center"
                                               PointerPressed="DetailDcStatus_PointerPressed"
                                               PointerEntered="LinkText_PointerEntered" PointerExited="LinkText_PointerExited"/>
                                    <Button x:Name="DetailDcInfoBtn" x:FieldModifier="internal" Grid.Column="2"
                                            Content="정보" FontSize="11" Padding="6,2,6,2"
                                            Background="{StaticResource SurfaceOverlayBrush}"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32"
                                            Click="InfoButton_Click"/>
                                    <Button x:Name="DetailDcInstallBtn" x:FieldModifier="internal" Grid.Column="3"
                                            Click="InstallDcButton_Click"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            CornerRadius="8" FontSize="12" Height="32"/>
                                    <Button x:Name="DetailDcIniBtn" x:FieldModifier="internal" Grid.Column="4"
                                            Click="DcCogButton_Click"
                                            Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="Display Commander 설정">
                                        <TextBlock Text="⚙" FontSize="14" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="DetailDcDeleteBtn" x:FieldModifier="internal" Grid.Column="5"
                                            Click="UninstallDcButton_Click"
                                            Background="{StaticResource AccentRedBgBrush}" Foreground="{StaticResource AccentRedBrush}"
                                            BorderBrush="{StaticResource AccentPurpleBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="Display Commander 제거" Opacity="0" IsHitTestVisible="False">
                                        <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource AccentRedBrush}"/>
                                    </Button>
                                </Grid>

                                <!-- No mod message -->
                                <Border x:Name="DetailNoModMsg" x:FieldModifier="internal" Visibility="Collapsed"
                                        Background="{StaticResource AccentPurpleBgBrush}" CornerRadius="8" Padding="12,8"
                                        BorderBrush="{StaticResource AccentPurpleBorderBrush}" BorderThickness="1">
                                    <TextBlock Text="이 게임에 사용할 수 있는 RenoDX 모드가 없습니다"
                                               FontSize="12" Foreground="{StaticResource TextDisabledBrush}" TextAlignment="Center"/>
                                </Border>

                                <!-- Progress bars -->
                                <StackPanel x:Name="DetailProgressSection" Spacing="4">
                                    <ProgressBar x:Name="DetailRefProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailRefMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>

                                    <ProgressBar x:Name="DetailRsProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentTealDimBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailRsMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>

                                    <ProgressBar x:Name="DetailUlProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailUlMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailDcProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailDcMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailDofFixProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailDofFixMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailDxvkProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailDxvkMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailRdxProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailRdxMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailLumaProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentGreenBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailLumaMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentGreenBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                </StackPanel>
                                </StackPanel><!-- /DetailComponentsBody -->
                            </StackPanel>
                        </Border>

                        <!-- ── Game Overrides section ── -->
                        <Border x:Name="OverridesContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <!-- Collapse header — wired in BuildOverridesPanel -->
                                <StackPanel x:Name="OverridesHeaderRow" x:FieldModifier="internal"
                                            Orientation="Horizontal" Spacing="0"/>
                                <!-- Body — all overrides content added here by builder -->
                                <StackPanel x:Name="OverridesPanel" x:FieldModifier="internal" Spacing="6"/>
                            </StackPanel>
                        </Border>

                        <!-- ── Neural Rendering section ── -->
                        <Border x:Name="NeuralRenderingContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel x:Name="NeuralRenderingPanel" x:FieldModifier="internal" Spacing="6"/>
                        </Border>

                        <!-- ── DLSS / Streamline section ── -->
                        <Border x:Name="NvidiaProfileDlssContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel x:Name="NvidiaProfileDlssPanel" x:FieldModifier="internal" Spacing="6"/>
                        </Border>

                        <!-- ── Driver Settings section ── -->
                        <Border x:Name="NvidiaProfileDriverContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel x:Name="NvidiaProfileDriverPanel" x:FieldModifier="internal" Spacing="6"/>
                        </Border>

                        <!-- ── Legacy container — kept for migration, never shown ── -->
                        <Border x:Name="NvidiaProfileContainer" x:FieldModifier="internal"
                                Visibility="Collapsed"/>

                        <!-- ── Management section (folder, reset, report) ── -->
                        <Border x:Name="ManagementContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel x:Name="ManagementPanel" x:FieldModifier="internal" Spacing="6"/>
                        </Border>
                        <!-- ── Extras section ── -->
                        <Border x:Name="ExtrasContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel Spacing="6">
                                <StackPanel x:Name="ExtrasPanel" x:FieldModifier="internal" Spacing="6"/>
                                <ProgressBar x:Name="DetailOsProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                             Maximum="100" Height="3" CornerRadius="2"
                                             Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                <TextBlock x:Name="DetailOsMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                           Visibility="Collapsed" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                    <!-- Skeleton detail panel overlay (removed programmatically after first load) -->
                    <ScrollViewer x:Name="SkeletonDetailScrollViewer" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Visibility="Visible">
                        <StackPanel x:Name="SkeletonDetailPanel" Spacing="16"
                                    Padding="24,18,24,24"/>
                    </ScrollViewer>

                </Grid>
            </Grid>

            <!--  SETTINGS PANEL  -->
            <Grid x:Name="SettingsPanel" x:FieldModifier="internal" Visibility="Collapsed" Background="{StaticResource SurfaceBaseBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Back button bar -->
                <Border Grid.Row="0" Padding="24,12,24,10" Background="{StaticResource SurfaceHeaderBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <Button x:Name="SettingsBackBtn" Content="← 게임으로 돌아가기"
                                Click="SettingsBack_Click"
                                Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,6" FontSize="12"/>
                        <TextBlock Text="설정" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="대부분의 설정은 변경하는 즉시 저장됩니다. 설정에 마우스를 올리면 자세한 내용을 볼 수 있습니다."
                                   FontSize="12" Foreground="{StaticResource SettingsHelpBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Scrollable settings content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <!-- Width and alignment are set from C# (SettingsHandler.Navigation) once the section list is added -->
                    <StackPanel x:Name="SettingsCardsPanel" x:FieldModifier="internal"
                                Padding="32,24,32,40" Spacing="28" MaxWidth="1000"
                                HorizontalAlignment="Center">
                        <!-- Settings buttons keep their own text colour on hover/press (the hover shows through the
                             background). WinUI could leave the hover text colour stuck after the pointer left. -->
                        <StackPanel.Resources>
                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsLabelBrush"/>
                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsLabelBrush"/>
                        </StackPanel.Resources>

                        <!-- ══════════════════════════════════════════════════════════
                             SETTINGS SECTIONS — each section is an unnamed StackPanel with
                             Tag="Section:<Key>" (found from C# by Tag, never by x:Name).
                             Keys: General, Accounts, ReShade, Display, Dlss, Driver, Components, Tools.
                             New settings go into the matching section.
                             ══════════════════════════════════════════════════════════ -->

                        <!-- ══════════════════════════════════════════════════════════
                             SECTION 1: GENERAL
                             Layout follows the agreed mock-up: cards with two columns of
                             label-left / control-right rows (styles in Themes/DarkTheme.xaml).
                             ══════════════════════════════════════════════════════════ -->
                        <StackPanel Tag="Section:General" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="일반" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="업데이트 및 PC에서 RHI가 동작하는 방식입니다. 처음이라면 여기서 시작하세요."
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Card: Updates -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="업데이트" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Check for updates (countdown is inserted above the note in C#) + Components to check -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <TextBlock Text="업데이트 확인" Style="{StaticResource SettingsHeadStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="RHI는 실행 중일 때 1시간마다 확인합니다(GitHub 토큰이 없으면 4시간마다). 기다리지 않으려면 지금 확인하세요."/>
                                            <Button x:Name="CheckForUpdatesBtn" Content="업데이트 확인"
                                                    Click="CheckForUpdatesButton_Click"
                                                    Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                    ToolTipService.ToolTip="모든 구성 요소와 앱의 업데이트를 확인합니다">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                                </Button.Resources>
                                            </Button>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="백그라운드 확인" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="BackgroundUpdateChecksCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          SelectionChanged="BackgroundUpdateChecksCombo_SelectionChanged">
                                                    <ToolTipService.ToolTip>
                                                        <ToolTip>
                                                            <TextBlock TextWrapping="Wrap" MaxWidth="280">
                                                                <Run Text="켜짐: ReShade, RenoDX, OptiScaler, Nexus Mods 및 기타 모든 구성 요소를 포함한 모든 업데이트 확인이 시작 시와 1시간마다(GitHub 토큰이 없으면 4시간마다) 자동으로 실행됩니다."/><LineBreak/>
                                                                <Run Text="최소: 매니페스트, PCGW 데이터, DLSS 버전만 자동으로 업데이트됩니다. 구성 요소 업데이트 확인은 새로 고침 또는 모두 업데이트를 클릭할 때만 실행됩니다."/>
                                                            </TextBlock>
                                                        </ToolTip>
                                                    </ToolTipService.ToolTip>
                                                    <ComboBoxItem Content="켜짐"/>
                                                    <ComboBoxItem Content="최소"/>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock Text="확인할 구성 요소" Style="{StaticResource SettingsHeadStyle}"
                                                       ToolTipService.ToolTip="개별 구성 요소의 업데이트 확인을 끕니다. 끄면 해당 구성 요소는 시작 시나 모두 업데이트 중에 확인되지 않습니다."/>
                                            <TextBlock x:Name="GlobalUpdateSummaryText" x:FieldModifier="internal"
                                                       Style="{StaticResource SettingsStatusStyle}"/>
                                            <Button x:Name="GlobalUpdateInclusionBtn"
                                                    Content="선택"
                                                    Click="GlobalUpdateInclusion_Click"
                                                    Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                    ToolTipService.ToolTip="RHI가 업데이트를 확인할 구성 요소를 선택합니다. 끈 구성 요소는 시작 시나 모두 업데이트 중에 확인되지 않습니다."/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Automatic updates (Components, DLSS, Streamline) -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="자동 업데이트" Style="{StaticResource SettingsHeadStyle}"/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="구성 요소" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="AutoUpdateComponentsCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="켜짐이면 RHI가 업데이트 확인 후 백그라운드에서 구성 요소 업데이트를 자동으로 설치합니다. 업데이트가 감지될 때 실행 중인 게임은 종료된 후 업데이트됩니다. 앱 업데이트에는 적용되지 않습니다."
                                                          SelectionChanged="AutoUpdateComponentsCombo_SelectionChanged">
                                                    <ComboBoxItem Content="꺼짐"/>
                                                    <ComboBoxItem Content="켜짐"/>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock Style="{StaticResource SettingsHelpStyle}"
                                                       Text="ReShade, RenoDX, ReLimiter, Display Commander, OptiScaler, RE Framework, Luma, DXVK, DOF 수정을 백그라운드에서 설치합니다."/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="DLSS" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="AutoUpdateDlssCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="새 버전이 출시되면 게임을 최신 DLSS로 교체합니다. 이전 최신 버전을 쓰는 게임에만 적용되며, 직접 고른 이전 버전은 그대로 둡니다."
                                                          SelectionChanged="AutoUpdateDlssCombo_SelectionChanged">
                                                    <ComboBoxItem Content="꺼짐"/>
                                                    <ComboBoxItem Content="켜짐"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Streamline" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="AutoUpdateStreamlineCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="새 버전이 출시되면 게임을 최신 Streamline으로 교체합니다. 이전 최신 버전을 쓰는 게임에만 적용되며, 직접 고른 이전 버전은 그대로 둡니다."
                                                          SelectionChanged="AutoUpdateStreamlineCombo_SelectionChanged">
                                                    <ComboBoxItem Content="꺼짐"/>
                                                    <ComboBoxItem Content="켜짐"/>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="RHI 자체 업데이트는 묻지 않고 설치되지 않습니다."/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card: Windows and Admin Mode -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Windows 및 관리자 모드" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Windows (system tray, start with Windows) -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <TextBlock Text="Windows" Style="{StaticResource SettingsHeadStyle}"/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="닫을 때 트레이로" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="CloseToTrayCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="창을 닫아도 RHI가 시스템 트레이에서 계속 실행됩니다."
                                                          SelectionChanged="CloseToTrayCombo_SelectionChanged">
                                                    <ComboBoxItem Content="꺼짐"/>
                                                    <ComboBoxItem Content="켜짐"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="트레이 메뉴에 최근 게임" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="RecentGamesCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="트레이 아이콘이나 작업 표시줄에 고정된 아이콘을 마우스 오른쪽 버튼으로 클릭해 최근 게임을 빠르게 실행합니다."
                                                          SelectionChanged="RecentGamesCombo_SelectionChanged">
                                                    <ComboBoxItem Content="꺼짐"/>
                                                    <ComboBoxItem Content="켜짐"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Windows 시작 시 실행" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="StartWithWindowsCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          SelectionChanged="StartWithWindowsCombo_SelectionChanged">
                                                    <ComboBoxItem Content="꺼짐"/>
                                                    <ComboBoxItem Content="켜짐"/>
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Admin Mode + Drop Helper -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="관리자 모드" Style="{StaticResource SettingsHeadStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="매번 확인 창 없이 RHI를 관리자 권한으로 실행합니다. ReBAR, DLSS 표시기, Smooth Motion, 저지연 Ultra에 필요합니다."/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="관리자 모드" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="AdminModeCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="RHI를 관리자 권한으로 실행하는 예약 작업을 만들어 매번 확인 창이 뜨지 않게 합니다. RHI를 다시 시작한 후 적용됩니다."
                                                          SelectionChanged="AdminModeCombo_SelectionChanged">
                                                    <ComboBoxItem Content="꺼짐"/>
                                                    <ComboBoxItem Content="켜짐"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="드롭 도우미" Style="{StaticResource SettingsLabelStyle}"/>
                                                    <Border BorderBrush="{StaticResource AccentAmberDimBrush}" BorderThickness="1"
                                                            CornerRadius="9" Padding="6,0,6,1" VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="관리자 모드가 켜져 있을 때만 사용됩니다.">
                                                        <TextBlock Text="관리자" FontSize="10" Foreground="{StaticResource AccentAmberBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <ComboBox Grid.Column="1" x:Name="DropHelperCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="드롭 도우미 창은 관리자 모드에서 Discord 끌어서 놓기를 가능하게 합니다. 필요 없으면 끄세요. 다시 시작해야 합니다."
                                                          SelectionChanged="DropHelperCombo_SelectionChanged">
                                                    <ComboBoxItem Content="꺼짐"/>
                                                    <ComboBoxItem Content="켜짐"/>
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════════════════
                             SECTION 2: ACCOUNTS & DATA
                             (RenoDxDbSourceCard is made visible in SettingsHandler; NexusModsCard
                             is shown when FeatureFlags.NexusMods is on: dev unlock or manifest flag)
                             ══════════════════════════════════════════════════════════ -->
                        <StackPanel Tag="Section:Accounts" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="계정 및 데이터" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="RHI가 모드 정보를 가져오는 곳과 사용할 수 있는 계정입니다."
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <Border x:Name="RenoDxDbSourceCard" x:FieldModifier="internal"
                                    Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="계정 및 모드 데이터" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: GitHub token -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <TextBlock Text="GitHub 토큰" Style="{StaticResource SettingsHeadStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       ToolTipService.ToolTip="토큰을 사용하면 GitHub API 요청 한도가 시간당 60회에서 5,000회로 늘어납니다. 업데이트 확인, DLSS 버전 조회, 매니페스트 가져오기의 안정성이 향상됩니다."
                                                       Text="토큰이 없으면 RHI는 시간당 GitHub 요청이 60회로 제한되며, 토큰을 사용하면 5,000회로 늘어납니다."/>

                                            <!-- Status text (connected / code display / error) -->
                                            <TextBlock x:Name="GitHubStatusText" x:FieldModifier="internal"
                                                       Style="{StaticResource SettingsStatusStyle}"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       Text="연결 안 됨 (시간당 60회)"/>

                                            <!-- Personal Access Token -->
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="토큰" Style="{StaticResource SettingsLabelStyle}"/>
                                                <Grid Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="GitHubPatBox" x:FieldModifier="internal"
                                                             PlaceholderText="ghp_..."
                                                             Style="{StaticResource SettingsTextBoxStyle}"
                                                             IsSpellCheckEnabled="False"
                                                             InputScope="Url"
                                                             ToolTipService.ToolTip="GitHub 개인 액세스 토큰(PAT)을 붙여 넣으세요. 취소할 때까지 유효합니다. 권한 범위는 필요 없으니 생성해서 붙여 넣기만 하면 됩니다."/>
                                                    <Button Grid.Column="1" x:Name="GitHubPatSaveBtn" x:FieldModifier="internal"
                                                            Content="저장"
                                                            Click="GitHubPatSaveBtn_Click"
                                                            Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"/>
                                                </Grid>
                                            </Grid>
                                            <TextBlock x:Name="GitHubPatStatusText" x:FieldModifier="internal"
                                                       Style="{StaticResource SettingsNoteStyle}"
                                                       Text="" Visibility="Collapsed"/>
                                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                                <HyperlinkButton NavigateUri="https://github.com/settings/tokens/new?description=RHI&amp;scopes="
                                                                 Content="토큰 만들기"
                                                                 FontSize="12" MinHeight="30" Padding="12,5" CornerRadius="8"
                                                                 BorderThickness="1"
                                                                 Background="{StaticResource SurfaceOverlayBrush}"
                                                                 BorderBrush="{StaticResource BorderStrongBrush}"
                                                                 Foreground="{StaticResource TextSecondaryBrush}"
                                                                 ToolTipService.ToolTip="github.com/settings/tokens를 엽니다. 체크할 항목은 없으며, 생성한 뒤 위에 붙여 넣으세요."/>
                                                <Button x:Name="GitHubPatClearBtn" x:FieldModifier="internal"
                                                        Content="제거"
                                                        Click="GitHubPatClearBtn_Click"
                                                        Style="{StaticResource SettingsDangerButtonStyle}" Foreground="{StaticResource AccentRedBrush}"
                                                        ToolTipService.ToolTip="저장된 토큰을 제거합니다.">
                                                    <Button.Resources>
                                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AccentRedBrush"/>
                                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentRedBrush"/>
                                                    </Button.Resources>
                                                </Button>
                                                <!-- Disconnect — shown only when signed in -->
                                                <StackPanel x:Name="GitHubDisconnectRow" x:FieldModifier="internal"
                                                            Visibility="Collapsed">
                                                    <Button Content="로그아웃"
                                                            Click="GitHubDisconnectBtn_Click"
                                                            Style="{StaticResource SettingsDangerButtonStyle}" Foreground="{StaticResource AccentRedBrush}"
                                                            ToolTipService.ToolTip="GitHub에서 로그아웃합니다.">
                                                        <Button.Resources>
                                                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AccentRedBrush"/>
                                                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentRedBrush"/>
                                                        </Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </controls:WrapPanel>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Mod data source + Nexus Mods -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="모드 데이터 출처" Style="{StaticResource SettingsHeadStyle}"/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="출처" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="RenoDxDbSourceCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="RHI 데이터베이스는 커뮤니티가 관리하는 RHI 데이터베이스를 사용합니다(권장). RenoDX 위키는 RenoDX 위키 스크래퍼를 사용합니다. 이 설정을 바꾸면 즉시 새로 고침됩니다.">
                                                    <ComboBoxItem Content="RHI 데이터베이스" Tag="DbOnly"/>
                                                    <ComboBoxItem Content="RenoDX 위키" Tag="WikiOnly"/>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock Style="{StaticResource SettingsHelpStyle}"
                                                       Text="RHI가 어떤 게임에 모드가 있는지 조회하는 곳입니다. 바꾸면 라이브러리가 새로 고침됩니다."/>

                                            <!-- Nexus Mods (shown when FeatureFlags.NexusMods is on) -->
                                            <Border x:Name="NexusModsCard" x:FieldModifier="internal"
                                                    Visibility="Collapsed">
                                                <StackPanel Spacing="9">
                                                    <TextBlock Text="Nexus Mods" Style="{StaticResource SettingsHeadStyle}"/>
                                                    <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                               Text="연결을 누르면 브라우저에서 Nexus Mods에 로그인합니다. 프리미엄 사용자는 원클릭 다운로드와 자동 업데이트를, 무료 사용자는 브라우저 원클릭 다운로드를 사용할 수 있습니다."/>
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*" MaxWidth="210"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="계정" Style="{StaticResource SettingsLabelStyle}"/>
                                                        <Grid Grid.Column="1" ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="NexusStatusText" x:FieldModifier="internal"
                                                                       FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                                       Text="연결 안 됨"/>
                                                            <Button Grid.Column="1" x:Name="NexusConnectBtn" x:FieldModifier="internal"
                                                                    Content="연결"
                                                                    Click="NexusConnectBtn_Click"
                                                                    ToolTipService.ToolTip="RHI가 Nexus에서 모드를 다운로드할 수 있도록 브라우저에서 Nexus Mods에 로그인합니다."
                                                                    Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"/>
                                                        </Grid>
                                                    </Grid>
                                                    <StackPanel x:Name="NexusDisconnectRow" x:FieldModifier="internal"
                                                                Visibility="Collapsed" HorizontalAlignment="Right">
                                                        <Button Content="연결 해제"
                                                                Click="NexusDisconnectBtn_Click"
                                                                ToolTipService.ToolTip="Nexus Mods에서 로그아웃하고 저장된 키를 제거합니다."
                                                                Style="{StaticResource SettingsDangerButtonStyle}" Foreground="{StaticResource AccentRedBrush}">
                                                            <Button.Resources>
                                                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AccentRedBrush"/>
                                                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentRedBrush"/>
                                                            </Button.Resources>
                                                        </Button>
                                                    </StackPanel>
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*" MaxWidth="210"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="nxm:// 링크" Style="{StaticResource SettingsLabelStyle}"
                                                                   ToolTipService.ToolTip="RHI를 nxm:// 처리기로 등록해 Nexus의 &quot;Mod Manager Download&quot; 버튼이 RHI에서 바로 열리게 합니다."/>
                                                        <Grid Grid.Column="1" ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="NxmStatusText" x:FieldModifier="internal"
                                                                       FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Text="등록 안 됨"/>
                                                            <Button Grid.Column="1" x:Name="NxmRegisterBtn" x:FieldModifier="internal"
                                                                    Content="등록"
                                                                    Click="NxmRegisterBtn_Click"
                                                                    Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                                    ToolTipService.ToolTip="Nexus &quot;Mod Manager Download&quot; 링크를 RHI에서 엽니다."/>
                                                        </Grid>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════════════════
                             SECTION 3: RESHADE & RENODX
                             ══════════════════════════════════════════════════════════ -->
                        <StackPanel Tag="Section:ReShade" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="ReShade 및 RenoDX" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="ReShade를 사용하는 모든 게임의 기본값입니다. 각 게임의 ReShade ⚙에서 개별적으로 바꿀 수 있습니다."
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Card: Keys, screenshots and brightness -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="키, 스크린샷 및 밝기" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Keys and screenshots -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <TextBlock Text="키 및 스크린샷" Style="{StaticResource SettingsHeadStyle}"
                                                       ToolTipService.ToolTip="관리되는 모든 reshade.ini 파일에 적용되는 스크린샷 저장 경로와 ReShade 키 설정입니다."/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="오버레이 키" Style="{StaticResource SettingsLabelStyle}"/>
                                                <TextBox Grid.Column="1" x:Name="HotkeyBox" x:FieldModifier="internal"
                                                         PlaceholderText="키를 누르세요..." IsReadOnly="True"
                                                         Style="{StaticResource SettingsTextBoxStyle}" FontFamily="Consolas"
                                                         ToolTipService.ToolTip="게임 내 ReShade 오버레이를 엽니다. 바꾸려면 여기를 클릭하고 키를 누르세요."
                                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="스크린샷 키" Style="{StaticResource SettingsLabelStyle}"/>
                                                <Grid Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="ScreenshotHotkeyBox" x:FieldModifier="internal"
                                                             PlaceholderText="키를 누르세요..." IsReadOnly="True"
                                                             Style="{StaticResource SettingsTextBoxStyle}" FontFamily="Consolas"
                                                             ToolTipService.ToolTip="키를 눌러 지정하거나 Backspace를 눌러 지우세요."
                                                             PreviewKeyDown="ScreenshotHotkeyBox_PreviewKeyDown"/>
                                                    <Button Grid.Column="1" Content="↺" Click="ResetScreenshotHotkey_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="Print Screen으로 초기화"/>
                                                </Grid>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="스크린샷 폴더" Style="{StaticResource SettingsLabelStyle}"/>
                                                <Grid Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="ScreenshotPathBox" x:FieldModifier="internal"
                                                             PlaceholderText="폴더를 입력하거나 선택하세요"
                                                             Style="{StaticResource SettingsTextBoxStyle}"
                                                             ToolTipService.ToolTip="ReShade가 스크린샷을 저장하는 곳입니다. 폴더를 입력하고 Enter를 누르거나 찾아보기를 사용하세요."
                                                             KeyDown="ScreenshotPathBox_KeyDown"
                                                             LostFocus="ScreenshotPathBox_LostFocus"/>
                                                    <Button Grid.Column="1" Content="찾아보기" Click="BrowseScreenshotPath_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="스크린샷 폴더 선택"/>
                                                    <Button Grid.Column="2" Content="열기" Click="OpenScreenshotFolder_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="탐색기에서 스크린샷 폴더 열기"/>
                                                </Grid>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="게임별 폴더" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="PerGameScreenshotCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="켜짐이면 게임마다 별도의 스크린샷 하위 폴더를 사용합니다."
                                                          SelectionChanged="PerGameScreenshotCombo_SelectionChanged">
                                                    <ComboBoxItem Content="꺼짐"/>
                                                    <ComboBoxItem Content="켜짐"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="효과 목록 스타일" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="RsVariableListUseTabsCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="ReShade 오버레이에서 셰이더가 표시되는 방식을 정합니다. 탭은 효과 파일을 이름 있는 탭으로 묶고, 트리는 접을 수 있는 계층 구조로 표시합니다."
                                                          SelectionChanged="RsVariableListUseTabsCombo_SelectionChanged">
                                                    <ComboBoxItem Content="탭"/>
                                                    <ComboBoxItem Content="트리"/>
                                                </ComboBox>
                                            </Grid>
                                            <Button x:Name="ApplyHotkeyBtn" x:FieldModifier="internal"
                                                    Content="모든 게임에 쓰기"
                                                    Click="ApplyScreenshotPath_Click"
                                                    Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                    ToolTipService.ToolTip="오버레이 키, 스크린샷 키, 스크린샷 폴더, 효과 목록 스타일을 모든 게임의 reshade.ini에 씁니다. 숨긴 게임과 자체 reshade.ini를 유지하도록 설정된 게임은 건너뜁니다.">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                                </Button.Resources>
                                            </Button>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="숨긴 게임과 자체 reshade.ini를 유지하도록 설정된 게임은 건너뜁니다."/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: HDR brightness (RenoDX) -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="HDR 밝기 (RenoDX)" Style="{StaticResource SettingsHeadStyle}"/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="최대 밝기" Style="{StaticResource SettingsLabelStyle}"/>
                                                <Grid Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="PeakNitsBox" x:FieldModifier="internal"
                                                             PlaceholderText="nits"
                                                             Style="{StaticResource SettingsTextBoxStyle}"
                                                             ToolTipService.ToolTip="모니터의 최대 밝기(nits)로, reshade.ini 프리셋에 기록됩니다. 저장하려면 Enter를 누르세요."
                                                             KeyDown="PeakNitsBox_KeyDown"
                                                             LostFocus="PeakNitsBox_LostFocus"/>
                                                    <Button Grid.Column="1" x:Name="PeakNitsAutoBtn"
                                                            Content="자동" Click="PeakNitsAuto_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="모니터의 최대 밝기를 자동으로 읽어옵니다."/>
                                                    <Button Grid.Column="2" Content="⚙" Click="PeakNitsCog_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="전역 최대 nits 값을 받을 프리셋을 설정합니다."/>
                                                </Grid>
                                            </Grid>
                                            <Button x:Name="ApplyScreenshotPathBtn"
                                                    Content="모든 게임에 최대 밝기 쓰기"
                                                    Click="ApplyPeakNitsToAll_Click"
                                                    Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                    ToolTipService.ToolTip="최대 nits 값을 모든 게임의 reshade.ini에 씁니다. 숨긴 게임과 자체 reshade.ini를 유지하도록 설정된 게임은 건너뜁니다.">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card: Shaders and addons -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="셰이더 및 애드온" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Shader management + download all -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="셰이더" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="CustomShadersCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="RHI 관리: 내장 셰이더 팩을 모든 게임에 배포합니다.&#10;사용자 지정: 자신의 셰이더 폴더를 사용합니다.&#10;꺼짐: RHI가 어떤 게임의 셰이더도 건드리지 않습니다."
                                                          SelectionChanged="CustomShadersCombo_SelectionChanged">
                                                    <ComboBoxItem Content="꺼짐"/>
                                                    <ComboBoxItem Content="RHI 관리"/>
                                                    <ComboBoxItem Content="사용자 지정"/>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock Style="{StaticResource SettingsHelpStyle}"
                                                       Text="이 설정을 바꾸면 모든 게임의 셰이더가 업데이트되므로 RHI가 먼저 확인합니다."/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="모든 셰이더 다운로드" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="CacheAllShadersCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="켜짐이면 시작 시 모든 셰이더 팩을 다운로드해 캐시합니다. 꺼짐이면 필요할 때 팩을 다운로드합니다."
                                                          SelectionChanged="CacheAllShadersCombo_SelectionChanged">
                                                    <ComboBoxItem Content="꺼짐"/>
                                                    <ComboBoxItem Content="켜짐"/>
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Addon watch folder -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="애드온 감시 폴더" Style="{StaticResource SettingsLabelStyle}"/>
                                                <Grid Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="AddonWatchFolderBox" x:FieldModifier="internal"
                                                             PlaceholderText="다운로드 (기본값)"
                                                             Style="{StaticResource SettingsTextBoxStyle}"
                                                             ToolTipService.ToolTip="RHI가 이 폴더에서 RenoDX 애드온 파일(.addon64/.addon32)과 압축 파일을 감시합니다. 기본값은 다운로드 폴더입니다."
                                                             KeyDown="AddonWatchFolderBox_KeyDown"
                                                             LostFocus="AddonWatchFolderBox_LostFocus"/>
                                                    <Button Grid.Column="1" Content="찾아보기" Click="BrowseAddonWatchFolder_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="RHI가 애드온 다운로드를 감시할 폴더 선택"/>
                                                    <Button Grid.Column="2" Content="초기화" Click="ResetAddonWatchFolder_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="다운로드 폴더로 되돌리기"/>
                                                </Grid>
                                            </Grid>
                                            <TextBlock Style="{StaticResource SettingsHelpStyle}"
                                                       Text="RHI가 다운로드한 RenoDX 애드온 파일을 여기서 찾습니다."/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════════════════
                             SECTION 4: DISPLAY & HDR
                             (ResolutionControlCard and DldsrControlCard are shown when
                             FeatureFlags.ResolutionControl is on — currently always)
                             ══════════════════════════════════════════════════════════ -->
                        <StackPanel Tag="Section:Display" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="디스플레이 및 HDR" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="RHI로 게임을 실행할 때 화면에 일어나는 일과, NVIDIA 제어판 없이 쓸 수 있는 디스플레이 옵션입니다."
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Card: Display -->
                            <Border x:Name="ResolutionControlCard" x:FieldModifier="internal"
                                    Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="디스플레이" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: When a game starts (HDR + resolution auto-toggle, target resolution) -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <TextBlock Text="게임이 시작될 때" Style="{StaticResource SettingsHeadStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="게임이 종료되면 자동으로 되돌립니다."/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Windows HDR" Style="{StaticResource SettingsLabelStyle}"/>
                                                <Grid Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="HdrAutoToggleCombo" x:FieldModifier="internal"
                                                              Style="{StaticResource SettingsComboStyle}"
                                                              ToolTipService.ToolTip="켜짐이면 RHI로 게임을 실행할 때 Windows HDR이 자동으로 켜지고 게임 종료 시 꺼집니다."
                                                              SelectionChanged="HdrAutoToggleCombo_SelectionChanged">
                                                        <ComboBoxItem Content="꺼짐"/>
                                                        <ComboBoxItem Content="켜짐"/>
                                                    </ComboBox>
                                                    <Button Grid.Column="1" Content="⚙" Click="HdrSelectMonitors_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="HDR을 켤 모니터를 선택합니다. 비워 두면 = 주 디스플레이만."/>
                                                </Grid>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="해상도 변경" Style="{StaticResource SettingsLabelStyle}"/>
                                                <Grid Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="ResAutoToggleCombo" x:FieldModifier="internal"
                                                              Style="{StaticResource SettingsComboStyle}"
                                                              ToolTipService.ToolTip="켜짐이면 게임 실행 시 대상 해상도로 전환하고 종료 시 복원합니다."
                                                              SelectionChanged="ResAutoToggleCombo_SelectionChanged">
                                                        <ComboBoxItem Content="꺼짐"/>
                                                        <ComboBoxItem Content="켜짐"/>
                                                    </ComboBox>
                                                    <Button Grid.Column="1" Content="⚙" Click="ResSelectMonitors_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="해상도를 변경할 모니터를 선택합니다."/>
                                                </Grid>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="해상도" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="ResolutionTargetCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="게임 실행 전에 전환할 바탕 화면 해상도입니다. 게임 종료 시 복원됩니다."
                                                          SelectionChanged="ResolutionTargetCombo_SelectionChanged"/>
                                            </Grid>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Output colour -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="출력 색상" Style="{StaticResource SettingsHeadStyle}"
                                                       ToolTipService.ToolTip="NVIDIA 제어판을 열지 않고 디스플레이 색 심도와 다이내믹 레인지를 설정합니다."/>
                                            <!-- Monitor row: C# hides the combo's parent row when no NVIDIA display is found -->
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="모니터" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="ColorDisplayCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="설정할 디스플레이를 선택합니다."
                                                          SelectionChanged="ColorDisplayCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="색 심도" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="ColorDepthCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="모니터로 보내는 색 채널당 비트 수입니다. HDR에는 10 bpc 이상이 적합합니다. 모니터와 케이블이 지원하는 심도만 작동합니다.">
                                                    <ComboBoxItem Content="8 bpc"/>
                                                    <ComboBoxItem Content="10 bpc"/>
                                                    <ComboBoxItem Content="12 bpc"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="다이내믹 레인지" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="ColorRangeCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Full은 PC 모니터에, Limited는 비디오 레벨을 쓰는 TV에 적합합니다. 잘못 고르면 검은색이 회색으로 뜨거나 뭉개져 보입니다.">
                                                    <ComboBoxItem Content="Full"/>
                                                    <ComboBoxItem Content="Limited"/>
                                                </ComboBox>
                                            </Grid>
                                            <Button Content="적용"
                                                    x:Name="ColorApplyBtn" x:FieldModifier="internal"
                                                    Click="ColorApplyBtn_Click"
                                                    Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                    ToolTipService.ToolTip="선택한 모니터에 색 심도와 다이내믹 레인지를 적용합니다.">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                                </Button.Resources>
                                            </Button>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="디지털 바이브런스" Style="{StaticResource SettingsLabelStyle}"/>
                                                <Grid Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="모니터별" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{StaticResource SettingsHelpBrush}"/>
                                                    <Button Grid.Column="1" Content="조정"
                                                            Click="DigitalVibrance_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="디스플레이별로 NVIDIA 디지털 바이브런스(채도)를 조정합니다. 저장된 값은 앱 시작 시 자동으로 복원됩니다."/>
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card: DLDSR -->
                            <Border x:Name="DldsrControlCard" x:FieldModifier="internal"
                                    Visibility="Collapsed"
                                    Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="DLDSR" Style="{StaticResource SettingsCardTitleStyle}" VerticalAlignment="Center"/>
                                            <Button x:Name="DldsrInfoBtn" x:FieldModifier="internal"
                                                    Content="i" Click="DldsrInfoBtn_Click"
                                                    Width="20" Height="20" MinWidth="0" MinHeight="0" Padding="0"
                                                    CornerRadius="10" BorderThickness="1" FontSize="11"
                                                    Background="Transparent"
                                                    BorderBrush="{StaticResource AccentBlueBorderBrush}"
                                                    Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="DLDSR 제어 사용법"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource SettingsCardDescStyle}"
                                                   Text="NVIDIA 제어판을 열지 않고 DLDSR(Deep Learning Dynamic Super Resolution) 배율을 켜거나 끕니다. 먼저 NVIDIA 제어판에서 상태를 캡처하세요."/>
                                    </StackPanel>

                                    <StackPanel Spacing="9">
                                        <TextBlock Text="현재 상태" Style="{StaticResource SettingsHeadStyle}"/>
                                        <TextBlock x:Name="DldsrCurrentStateText" x:FieldModifier="internal"
                                                   Text="(확인 안 됨)"
                                                   Style="{StaticResource SettingsStatusStyle}"/>

                                        <!-- Smoothness slider + Set -->
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="부드러움" Style="{StaticResource SettingsLabelStyle}"/>
                                                <TextBlock x:Name="DldsrSmoothnessValueText" x:FieldModifier="internal"
                                                           Text="33%" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="DldsrSmoothnessSlider" x:FieldModifier="internal"
                                                        Minimum="0" Maximum="100" StepFrequency="1" TickFrequency="10"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                        ToolTipService.ToolTip="DSR 부드러움(0-100%)을 조정합니다. 값이 낮을수록 선명하고, 높을수록 부드럽습니다. 적용 시 약 15초간 화면이 꺼집니다."/>
                                                <Button Grid.Column="1"
                                                        x:Name="DldsrSmoothnessApplyBtn" x:FieldModifier="internal"
                                                        Content="설정" Click="DldsrSmoothnessApplyBtn_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="선택한 부드러움 값을 적용합니다. 약 15초간 화면이 꺼집니다."/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Saved state + Apply -->
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*" MaxWidth="300"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="저장된 상태" Style="{StaticResource SettingsLabelStyle}"/>
                                            <Grid Grid.Column="1" ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="DldsrStateCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="적용할 이전에 캡처한 DLDSR 상태를 선택합니다."/>
                                                <Button Grid.Column="1"
                                                        x:Name="DldsrApplyBtn" x:FieldModifier="internal"
                                                        Content="적용" Click="DldsrApplyBtn_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="선택한 DLDSR 상태를 적용합니다. 약 15초간 화면이 꺼집니다."/>
                                            </Grid>
                                        </Grid>
                                        <TextBlock Style="{StaticResource SettingsNoteStyle}" Foreground="{StaticResource AccentAmberBrush}"
                                                   Text="부드러움을 설정하거나 상태를 적용하면 약 15초간 화면이 검게 됩니다."/>

                                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                            <Button x:Name="DldsrCaptureBtn" x:FieldModifier="internal"
                                                    Content="현재 상태 캡처" Click="DldsrCaptureBtn_Click"
                                                    Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                    ToolTipService.ToolTip="NVIDIA 제어판에서 현재 DLDSR 상태를 캡처합니다. 먼저 NVIDIA 제어판에서 DLDSR을 설정한 뒤 캡처하세요."/>
                                            <Button x:Name="DldsrDeleteBtn" x:FieldModifier="internal"
                                                    Content="삭제" Click="DldsrDeleteBtn_Click"
                                                    Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                    ToolTipService.ToolTip="현재 선택한 저장된 상태를 삭제합니다."/>
                                            <Button x:Name="DldsrRefreshBtn" x:FieldModifier="internal"
                                                    Content="새로 고침" Click="DldsrRefreshBtn_Click"
                                                    Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                    ToolTipService.ToolTip="레지스트리에서 현재 DLDSR 상태를 새로 고칩니다."/>
                                        </controls:WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════════════════
                             SECTION 5: DLSS / STREAMLINE
                             ══════════════════════════════════════════════════════════ -->
                        <StackPanel Tag="Section:Dlss" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="DLSS / Streamline" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="각 게임 패널의 DLSS / Streamline 섹션과 같습니다."
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Card: Defaults (summary grid is built in C# by RefreshDlssDefaultsSummary) -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="기본값" Style="{StaticResource SettingsCardTitleStyle}"/>
                                        <TextBlock Style="{StaticResource SettingsCardDescStyle}"
                                                   Text="빠른 적용(각 게임의 DLSS / Streamline 섹션)이 게임에 적용하는 버전, 프리셋, 렌더 배율입니다."/>
                                    </StackPanel>
                                    <StackPanel Spacing="9">
                                        <StackPanel x:Name="DlssDefaultsSummaryPanel" x:FieldModifier="internal" Spacing="4"/>
                                        <Button Content="기본값 설정" Click="DlssDefaults_Click"
                                                Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource AccentBlueBrush}"
                                                ToolTipService.ToolTip="빠른 적용에 사용할 DLSS / Streamline 버전, 프리셋, 렌더 배율을 선택합니다.">
                                            <Button.Resources>
                                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                            </Button.Resources>
                                        </Button>
                                        <TextBlock Style="{StaticResource SettingsNoteStyle}" Foreground="{StaticResource AccentBlueBrush}"
                                                   Text="DLSS 및 Streamline 자동 업데이트: 일반 › 업데이트."/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card: Indicator, frame generation and batch deploy -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="표시기, 프레임 생성 및 일괄 배포" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: DLSS indicator + Multi frame generation (DMFG global base profile) -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="DLSS 표시기" Style="{StaticResource SettingsLabelStyle}"/>
                                                    <Border BorderBrush="{StaticResource AccentAmberDimBrush}" BorderThickness="1"
                                                            CornerRadius="9" Padding="6,0,6,1" VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="관리자 모드가 필요합니다 (일반 › Windows 및 관리자 모드).">
                                                        <TextBlock Text="관리자" FontSize="10" Foreground="{StaticResource AccentAmberBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <ComboBox Grid.Column="1" x:Name="DlssIndicatorCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="NVIDIA가 게임 구석에 표시하는 DLSS 텍스트 오버레이를 제어합니다. 전역 시스템 설정으로 모든 게임에 적용됩니다. 관리자 권한이 필요합니다."
                                                          SelectionChanged="DlssIndicatorCombo_SelectionChanged">
                                                    <ComboBoxItem Content="꺼짐"/>
                                                    <ComboBoxItem Content="켜짐"/>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock Text="멀티 프레임 생성 (RTX 50)" Style="{StaticResource SettingsHeadStyle}"
                                                       ToolTipService.ToolTip="전역 동적 멀티 프레임 생성(DMFG) 기본값입니다. 한 번 설정한 뒤 각 게임의 MFG 대화 상자에서 동적 모드만 켜면 됩니다."/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="최대 프레임" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="DmfgFrameCountCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="전역 DMFG 최대 프레임 수입니다. 동적 모드를 사용하는 게임은 게임별로 재정의하지 않는 한 이 값을 따릅니다."
                                                          SelectionChanged="DmfgFrameCountCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="목표 FPS" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="DmfgTargetFpsCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="전역 DMFG 목표 프레임 속도입니다. 꺼짐 = 목표 없음. Max Refresh Rate = 디스플레이에 맞춤. 또는 특정 FPS를 선택하세요."
                                                          SelectionChanged="DmfgTargetFpsCombo_SelectionChanged"/>
                                            </Grid>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Batch deploy -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="일괄 배포" Style="{StaticResource SettingsHeadStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="여러 게임에 DLSS 및 Streamline 버전과 프리셋을 한 번에 적용합니다."/>
                                            <Button Content="일괄 배포" Click="MassDlssDeploy_Click"
                                                    Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                    ToolTipService.ToolTip="DLSS 및 Streamline DLL 버전과 DLSS 프리셋을 여러 게임에 한 번에 배포합니다. 원본은 자동으로 백업됩니다. 설정한 기본값이 미리 채워집니다.">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════════════════
                             SECTION 6: DRIVER SETTINGS
                             ══════════════════════════════════════════════════════════ -->
                        <StackPanel Tag="Section:Driver" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="드라이버 설정" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="모든 게임의 드라이버 기본값입니다. 각 게임의 드라이버 설정 섹션이 이 값을 재정의합니다."
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Card: Driver defaults (NVAPI combos, populated with init guards in SettingsHandler) -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="드라이버 기본값" Style="{StaticResource SettingsCardTitleStyle}"
                                               ToolTipService.ToolTip="기본 NVIDIA 프로필을 통해 전역으로 적용되는 드라이버 수준 설정입니다. 게임별 설정은 각 게임 패널의 드라이버 설정 섹션에 있습니다."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: VSync, frame rate, G-Sync, refresh rate -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="VSync" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="GlobalVSyncCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="전역 VSync 모드 — 게임별 재정의가 없는 모든 게임에 적용됩니다."
                                                          SelectionChanged="GlobalVSyncCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="프레임 속도 제한" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="FpsLimitCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="NVIDIA 드라이버를 통한 전역 FPS 제한입니다. VRR 최적 프리셋은 VRR 범위를 유지하도록 주사율 바로 아래로 제한합니다. 제한을 선택하면 ReLimiter나 Display Commander가 있는 모든 게임의 게임별 FPS 제한이 꺼져 두 제한기가 충돌하지 않습니다."
                                                          SelectionChanged="FpsLimitCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="G-Sync" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="GSyncEnableCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="G-Sync/FreeSync 가변 주사율을 전역으로 켜거나 끕니다."
                                                          SelectionChanged="GSyncEnableCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="G-Sync 모드" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="GSyncModeCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="G-Sync/FreeSync 가변 주사율을 제어합니다. 매끄러운 경험을 위해 전체 화면 및 창 모드를 권장합니다."
                                                          SelectionChanged="GSyncModeCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="G-Sync 표시기" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="GSyncIndicatorCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="G-Sync가 활성화되면 게임에 NVIDIA G-Sync 표시기를 보여 줍니다. 전역 드라이버 설정으로 모든 게임에 적용됩니다."
                                                          SelectionChanged="GSyncIndicatorCombo_SelectionChanged">
                                                    <ComboBoxItem Content="꺼짐"/>
                                                    <ComboBoxItem Content="켜짐"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="선호 주사율" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="PreferredRefreshRateCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Highest available은 최대 주사율을 강제하고, App Setting은 게임이 주사율을 직접 정하게 합니다."
                                                          SelectionChanged="PreferredRefreshRateCombo_SelectionChanged"/>
                                            </Grid>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Power, shaders, ReBAR -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="전원 모드" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="GlobalPowerModeCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="전역 전원 관리 모드 — 게임별 재정의가 없는 모든 게임에 적용됩니다."
                                                          SelectionChanged="GlobalPowerModeCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="셰이더 캐시 크기" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="ShaderCacheSizeCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="컴파일된 셰이더 캐시의 최대 디스크 공간입니다. 클수록 = 다시 실행할 때 끊김이 줄어듭니다. 16GB가 드라이버 기본값입니다."
                                                          SelectionChanged="ShaderCacheSizeCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="셰이더 사전 컴파일" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="ShaderPrecompileCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="유휴 상태일 때 백그라운드에서 셰이더를 자동 컴파일합니다. 높을수록 = 유휴 시 CPU 사용량이 늘고, 첫 게임 로딩이 빨라집니다."
                                                          SelectionChanged="ShaderPrecompileCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="ReBAR" Style="{StaticResource SettingsLabelStyle}"/>
                                                    <!-- Shown by C# (ReBarAdminWarning) when RHI isn't running as admin -->
                                                    <Border BorderBrush="{StaticResource AccentAmberDimBrush}" BorderThickness="1"
                                                            CornerRadius="9" Padding="6,0,6,1" VerticalAlignment="Center"
                                                            Visibility="{Binding Visibility, ElementName=ReBarAdminWarning}"
                                                            ToolTipService.ToolTip="관리자 모드가 필요합니다 (일반 › Windows 및 관리자 모드).">
                                                        <TextBlock x:Name="ReBarAdminWarning" x:FieldModifier="internal"
                                                                   Text="관리자" FontSize="10"
                                                                   Foreground="{StaticResource AccentAmberBrush}"
                                                                   Visibility="Collapsed"/>
                                                    </Border>
                                                </StackPanel>
                                                <ComboBox Grid.Column="1" x:Name="GlobalReBarEnableCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="전역 Resizable BAR — 모든 게임에서 대용량 GPU 메모리 전송을 사용합니다. 관리자 권한과 호환 하드웨어(RTX 30 시리즈 이상)가 필요합니다."
                                                          SelectionChanged="GlobalReBarEnableCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="ReBAR 크기 제한" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="GlobalReBarSizeCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="최대 BAR 전송 크기입니다. 대부분의 게임에는 1GB가 최적입니다. ReBAR 관련 끊김이 있으면 512MB로 줄이세요."
                                                          SelectionChanged="GlobalReBarSizeCombo_SelectionChanged"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card: Profiles -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="프로필" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: create / back up / restore profiles -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                                <Button Content="Create missing profiles"
                                                        Click="CreateMissingNvidiaProfiles_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="아직 프로필이 없는 모든 게임에 NVIDIA 드라이버 프로필을 만듭니다. 프로필이 없는 게임에는 위의 드라이버 기본값(전원 모드, VSync 등)이 적용되지 않습니다."/>
                                                <Button Content="프로필 백업"
                                                        Click="ExportNvidiaProfiles_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="모든 게임별 NVIDIA 프로필 설정을 백업 파일로 저장합니다. 드라이버 업데이트 전에 유용합니다."/>
                                                <Button Content="프로필 복원"
                                                        Click="ImportNvidiaProfiles_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="이전 백업에서 게임별 NVIDIA 프로필 설정을 복원합니다."/>
                                            </controls:WrapPanel>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Reset -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="초기화" Style="{StaticResource SettingsHeadStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="되돌릴 수 없습니다. 각각 먼저 확인하며, 기본 선택은 취소입니다."/>
                                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                                <Button Content="모든 게임 프로필 초기화"
                                                        Click="ResetAllNvidiaProfiles_Click"
                                                        Style="{StaticResource SettingsDangerButtonStyle}" Foreground="{StaticResource AccentRedBrush}"
                                                        ToolTipService.ToolTip="모든 게임별 NVIDIA 프로필 재정의를 제거합니다. 전역 프로필은 새것처럼 됩니다.">
                                                    <Button.Resources>
                                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AccentRedBrush"/>
                                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentRedBrush"/>
                                                    </Button.Resources>
                                                </Button>
                                                <Button Content="셰이더 캐시 지우기"
                                                        Click="ClearNvidiaShaderCache_Click"
                                                        Style="{StaticResource SettingsDangerButtonStyle}" Foreground="{StaticResource AccentRedBrush}"
                                                        ToolTipService.ToolTip="NVIDIA DXCache 및 GLCache 폴더를 삭제합니다. 다음 실행 시 셰이더를 다시 컴파일하게 됩니다.">
                                                    <Button.Resources>
                                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AccentRedBrush"/>
                                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentRedBrush"/>
                                                    </Button.Resources>
                                                </Button>
                                            </controls:WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════════════════
                             SECTION 7: COMPONENTS (ReLimiter + OptiScaler)
                             ══════════════════════════════════════════════════════════ -->
                        <StackPanel Tag="Section:Components" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="구성 요소" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="ReLimiter, OptiScaler, GITC Uplift의 기본값입니다. 각 게임의 ⚙이 이 값을 재정의합니다."
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="ReLimiter 및 OptiScaler" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: ReLimiter -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <TextBlock Text="ReLimiter" Style="{StaticResource SettingsHeadStyle}"
                                                       ToolTipService.ToolTip="모든 게임에 적용되는 ReLimiter OSD 단축키와 전역 기능 설정입니다."/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="오버레이 키" Style="{StaticResource SettingsLabelStyle}"/>
                                                <TextBox Grid.Column="1" x:Name="UlHotkeyBox" x:FieldModifier="internal"
                                                         PlaceholderText="키를 누르세요..." IsReadOnly="True"
                                                         Style="{StaticResource SettingsTextBoxStyle}" FontFamily="Consolas"
                                                         ToolTipService.ToolTip="게임 내 ReLimiter OSD 오버레이를 켜고 끄는 키입니다."
                                                         PreviewKeyDown="UlHotkeyBox_PreviewKeyDown"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="목표 FPS" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="UlTargetFpsCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="모든 relimiter.ini 파일에 기록되는 전역 FPS 제한입니다. VRR 프리셋을 선택하거나 직접 값을 넣으려면 Custom을 선택하세요."
                                                          SelectionChanged="UlTargetFpsCombo_SelectionChanged">
                                                    <!-- Items populated in code-behind -->
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="공유 프리셋" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="UlSharedPresetsCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="켜짐이면 모든 게임이 같은 OSD 프리셋 파일을 공유합니다. 꺼짐이면 게임마다 자체 프리셋을 사용합니다."
                                                          SelectionChanged="UlSharedPresetsCombo_SelectionChanged">
                                                    <ComboBoxItem Content="꺼짐"/>
                                                    <ComboBoxItem Content="켜짐"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="DLSS 후킹" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="UlDlssHooksCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="ReLimiter OSD에 DLSS 품질 모드, 렌더 해상도, 활성 기능을 표시합니다. 충돌이 발생하면 끄세요."
                                                          SelectionChanged="UlDlssHooksCombo_SelectionChanged">
                                                    <ComboBoxItem Content="꺼짐"/>
                                                    <ComboBoxItem Content="켜짐"/>
                                                </ComboBox>
                                            </Grid>
                                            <Button x:Name="ApplyUlHotkeyBtn" x:FieldModifier="internal"
                                                    Content="모든 ReLimiter 게임에 쓰기"
                                                    Click="ApplyUlOsdHotkey_Click"
                                                    Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                    ToolTipService.ToolTip="오버레이 키, 공유 프리셋, DLSS 후킹, 목표 FPS를 모든 게임의 relimiter.ini에 씁니다. 숨긴 게임은 건너뜁니다.">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: OptiScaler -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="OptiScaler" Style="{StaticResource SettingsHeadStyle}"
                                                       ToolTipService.ToolTip="OptiScaler 설치에 사용할 GPU 종류, DLSS 입력 설정, 오버레이 단축키입니다."/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="GPU 종류" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="OsGpuCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="이 PC의 GPU 브랜드입니다. RHI는 이를 바탕으로 설치할 OptiScaler.ini를 고릅니다. DLSS 입력은 AMD와 Intel에서 표시됩니다."
                                                          SelectionChanged="OsGpuCombo_SelectionChanged">
                                                    <x:String>NVIDIA</x:String>
                                                    <x:String>AMD</x:String>
                                                    <x:String>Intel</x:String>
                                                </ComboBox>
                                            </Grid>
                                            <!-- DLSS inputs: shown by C# for AMD and Intel -->
                                            <StackPanel x:Name="OsDlssInputsPanel" x:FieldModifier="internal" Visibility="Collapsed">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*" MaxWidth="210"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="DLSS 입력" Style="{StaticResource SettingsLabelStyle}"/>
                                                    <ComboBox Grid.Column="1" x:Name="OsDlssInputsCombo" x:FieldModifier="internal"
                                                              Style="{StaticResource SettingsComboStyle}"
                                                              ToolTipService.ToolTip="켜짐: OptiScaler가 게임에 NVIDIA GPU로 보고하여 게임이 DLSS를 제공하고 OptiScaler가 그 입력을 사용합니다. 꺼짐: GPU 위장 없음. OptiScaler.ini가 설치될 때 사용됩니다."
                                                              SelectionChanged="OsDlssInputsCombo_SelectionChanged">
                                                        <x:String>꺼짐</x:String>
                                                        <x:String>켜짐</x:String>
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="오버레이 키" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="OsHotkeyCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="게임 내 OptiScaler 오버레이를 여는 키입니다. 새 설치에는 바로 저장되며, 이미 OptiScaler가 있는 게임은 버튼을 눌러 업데이트하세요."
                                                          SelectionChanged="OsHotkeyCombo_SelectionChanged">
                                                    <x:String>Insert</x:String>
                                                    <x:String>Home</x:String>
                                                    <x:String>End</x:String>
                                                    <x:String>삭제</x:String>
                                                    <x:String>Page Up</x:String>
                                                    <x:String>Page Down</x:String>
                                                    <x:String>F1</x:String>
                                                    <x:String>F2</x:String>
                                                    <x:String>F3</x:String>
                                                    <x:String>F4</x:String>
                                                    <x:String>F5</x:String>
                                                    <x:String>F6</x:String>
                                                    <x:String>F7</x:String>
                                                    <x:String>F8</x:String>
                                                    <x:String>F9</x:String>
                                                    <x:String>F10</x:String>
                                                    <x:String>F11</x:String>
                                                    <x:String>F12</x:String>
                                                </ComboBox>
                                            </Grid>
                                            <Button x:Name="ApplyOsHotkeyBtn" x:FieldModifier="internal"
                                                    Content="모든 OptiScaler 게임에 키 쓰기"
                                                    Click="ApplyOsHotkey_Click"
                                                    Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                    ToolTipService.ToolTip="OptiScaler가 설치된 모든 게임의 OptiScaler.ini에 오버레이 키를 씁니다. 숨긴 게임은 건너뜁니다.">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════════════════
                             SECTION 8: TOOLS & MAINTENANCE
                             (nothing is appended after this section)
                             ══════════════════════════════════════════════════════════ -->
                        <StackPanel Tag="Section:Tools" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="도구 및 유지 관리" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="일괄 작업, 폴더 및 로그, 최후의 수단용 수정입니다."
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Card: Tools -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="도구" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Deploy to many games (Mass INI + Mass Preset Install) -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <TextBlock Text="여러 게임에 배포" Style="{StaticResource SettingsHeadStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="INI 파일이나 ReShade 프리셋을 여러 게임에 한 번에 배포합니다. 단축키와 스크린샷 폴더는 유지됩니다."/>
                                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                                <Button Content="ReShade.ini" Click="MassDeployRsIni_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"/>
                                                <Button Content="relimiter.ini" Click="MassDeployUlIni_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"/>
                                                <Button Content="DisplayCommander.ini" Click="MassDeployDcIni_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"/>
                                                <Button Content="OptiScaler.ini" Click="MassDeployOsIni_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"/>
                                                <Button Content="ReShade 프리셋" Click="MassPresetInstall_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="ReShade 프리셋을 여러 게임에 한 번에 설치합니다."/>
                                            </controls:WrapPanel>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Folders and logs -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="폴더 및 로그" Style="{StaticResource SettingsHeadStyle}"
                                                       ToolTipService.ToolTip="모든 RHI 데이터는 AppData에 저장됩니다. Logs 폴더에는 문제 해결에 유용한 세션 사용 로그가 있습니다."/>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="자신의 ReShade, DLSS, Streamline DLL을 Custom 폴더에 넣으면 게임별 재정의로 사용할 수 있습니다."/>
                                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                                <Button x:Name="OpenAppDataBtn" Content="RHI 데이터" Click="OpenAppDataFolder_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="AppData의 RHI 데이터 폴더 열기"/>
                                                <Button x:Name="OpenDownloadsBtn" Content="다운로드" Click="OpenDownloadsFolder_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="RHI 다운로드 폴더 열기"/>
                                                <Button x:Name="OpenCustomBtn" Content="사용자 지정" Click="OpenCustomFolder_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="자신의 ReShade, DLSS, Streamline DLL용 Custom 폴더 열기"/>
                                                <Button x:Name="OpenLogsBtn" Content="로그" Click="OpenLogsFolder_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="Logs 폴더 열기"/>
                                                <Button x:Name="CopyLogsArchiveBtn" Content="로그 복사" Click="CopyLogsArchive_Click"
                                                        Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                        ToolTipService.ToolTip="모든 로그를 zip 압축 파일로 만들어 클립보드에 복사합니다 — Discord에 바로 붙여 넣으세요">
                                                    <Button.Resources>
                                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                                    </Button.Resources>
                                                </Button>
                                                <Button x:Name="ExportGameDataBtn" x:FieldModifier="internal" Content="게임 데이터 내보내기" Click="ExportGameData_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="게임 라이브러리 데이터(API, exe 경로, 엔진 정보)를 모아 JSON 파일을 클립보드에 복사합니다 — Discord에 붙여 넣어 RHI 커뮤니티 데이터베이스와 공유하세요"/>
                                            </controls:WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card: Troubleshooting -->
                            <Border Style="{StaticResource SettingsCardStyle}" BorderBrush="{StaticResource SettingsDangerCardBorderBrush}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="문제 해결" Style="{StaticResource SettingsCardTitleStyle}"
                                                   Foreground="{StaticResource AccentRedBrush}"/>
                                        <TextBlock Style="{StaticResource SettingsCardDescStyle}"
                                                   Text="심각한 문제가 있을 때 사용하세요. 각각 먼저 확인합니다."/>
                                    </StackPanel>
                                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                        <Button x:Name="FullRefreshBtn" x:FieldModifier="internal" Content="전체 새로 고침"
                                                Click="FullRefreshButton_Click"
                                                Style="{StaticResource SettingsDangerButtonStyle}" Foreground="{StaticResource AccentRedBrush}"
                                                ToolTipService.ToolTip="모든 캐시를 지우고 디스크에서 모든 것을 다시 검색합니다. 게임이 누락되었거나, 경로가 바뀌었거나, 게임에 DLSS가 추가되었거나, 게임 카드에 DLSS 섹션이 없을 때 최후의 수단으로 사용하세요.">
                                            <Button.Resources>
                                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AccentRedBrush"/>
                                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentRedBrush"/>
                                            </Button.Resources>
                                        </Button>
                                        <Button x:Name="PurgeCacheBtn"
                                                Content="스테이징 파일 정리"
                                                Click="PurgeCachedFiles_Click"
                                                Style="{StaticResource SettingsDangerButtonStyle}" Foreground="{StaticResource AccentRedBrush}"
                                                ToolTipService.ToolTip="캐시된 DLSS, Streamline, 구성 요소 스테이징 파일을 삭제해 디스크 공간을 확보합니다. 셰이더, 설치된 애드온, 버전 메타데이터는 유지됩니다. 파일은 필요할 때 자동으로 다시 다운로드됩니다.">
                                            <Button.Resources>
                                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AccentRedBrush"/>
                                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentRedBrush"/>
                                            </Button.Resources>
                                        </Button>
                                    </controls:WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Hidden combos retained for code-behind compatibility -->
                        <StackPanel Visibility="Collapsed">
                            <ComboBox x:Name="ReShadeChannelCombo" x:FieldModifier="internal"
                                      SelectionChanged="ReShadeChannelCombo_SelectionChanged">
                                <x:String>Stable (reshade.me releases)</x:String>
                                <x:String>Nightly (GitHub Actions builds)</x:String>
                            </ComboBox>
                            <ComboBox x:Name="DxvkVariantCombo" x:FieldModifier="internal"
                                      SelectionChanged="DxvkVariantCombo_SelectionChanged">
                                <x:String>Development (nightly builds)</x:String>
                                <x:String>Stable (tagged releases)</x:String>
                                <x:String>Lilium HDR</x:String>
                            </ComboBox>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- end SettingsPanel -->

            <!--  ABOUT PANEL  -->
            <Grid x:Name="AboutPanel" x:FieldModifier="internal" Visibility="Collapsed" Background="{StaticResource SurfaceBaseBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Back button bar -->
                <Border Grid.Row="0" Padding="24,12,24,10" Background="Transparent"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Content="← 게임으로 돌아가기"
                                Click="AboutBack_Click"
                                Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,6" FontSize="12"/>
                        <TextBlock Text="정보" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Scrollable about content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="32,24,32,40" Spacing="14" MaxWidth="800"
                                HorizontalAlignment="Center">

                        <!-- ── About ───────────────────────────────────────────────── -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,4">
                                    <Image Source="icon.ico" Width="48" Height="48"/>
                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock FontSize="20" FontWeight="Bold">
                                            <Run Text="RHI" Foreground="{StaticResource AccentTealBrush}"/>
                                        </TextBlock>
                                        <TextBlock x:Name="AboutVersionText" x:FieldModifier="internal" FontSize="12" Foreground="{StaticResource InlineDescriptionBrush}"/>
                                    </StackPanel>
